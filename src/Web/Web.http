# Requests for the RoboForge API, runnable from Rider, Visual Studio or VS Code (REST Client).
# Start the app first: dotnet run --project src/AppHost --launch-profile http
@Web_HostAddress = http://localhost:5040

# Health (Development only)
GET {{Web_HostAddress}}/health

###

# OpenAPI document
GET {{Web_HostAddress}}/openapi/v1.json

###

### ---------- Catalog ----------

# List all parts
GET {{Web_HostAddress}}/api/parts

###

# List one category: Housing, Drive, Electronics or Sensor
GET {{Web_HostAddress}}/api/parts?category=Drive

###

# Add a part (price in PLN)
# @name storePart
POST {{Web_HostAddress}}/api/parts
Content-Type: application/json

{
  "name": "Czujnik linii IR",
  "category": "Sensor",
  "priceAmount": 34.90,
  "leadTimeWorkingDays": 2,
  "weightGrams": 10
}

###

@partId = {{storePart.response.body.$.id}}

# Show the new part
GET {{Web_HostAddress}}/api/parts/{{partId}}

###

# Change its price
PUT {{Web_HostAddress}}/api/parts/{{partId}}/price
Content-Type: application/json

{
  "priceAmount": 29.90
}

###

# Discontinue it (final)
POST {{Web_HostAddress}}/api/parts/{{partId}}/discontinue

###

# Repricing a discontinued part → 422 with rule C4
PUT {{Web_HostAddress}}/api/parts/{{partId}}/price
Content-Type: application/json

{
  "priceAmount": 19.90
}

###

# A drive without a mount type → 422 with rule C3
POST {{Web_HostAddress}}/api/parts
Content-Type: application/json

{
  "name": "Napęd bez mocowania",
  "category": "Drive",
  "priceAmount": 120,
  "leadTimeWorkingDays": 3,
  "weightGrams": 300,
  "voltageVolts": 12,
  "maxLoadGrams": 1500
}

###

### ---------- Sales: configurator ----------
# Part IDs come from GET /api/parts. Sales copies the catalog from Catalog's events,
# so a part created a moment ago may need half a second before it can be added.

# @name storeConfiguration
POST {{Web_HostAddress}}/api/configurations

###

@configurationId = {{storeConfiguration.response.body.$.id}}
@housingId = 00000000-0000-0000-0000-000000000000
@driveId = 00000000-0000-0000-0000-000000000000

# Add a part (paste IDs from GET /api/parts above)
POST {{Web_HostAddress}}/api/configurations/{{configurationId}}/parts
Content-Type: application/json

{
  "partId": "{{housingId}}"
}

###

# Show the configuration
GET {{Web_HostAddress}}/api/configurations/{{configurationId}}

###

# Quote: violations (R1–R4, R7), price (R5) and lead time (R6)
GET {{Web_HostAddress}}/api/configurations/{{configurationId}}/quote

###

# Remove one piece of a part
DELETE {{Web_HostAddress}}/api/configurations/{{configurationId}}/parts/{{driveId}}

###

### ---------- Sales: orders ----------

# Place an order from a valid configuration (an invalid one → 422 with every violated rule)
# @name placeOrder
POST {{Web_HostAddress}}/api/orders
Content-Type: application/json

{
  "configurationId": "{{configurationId}}"
}

###

@orderId = {{placeOrder.response.body.$.id}}

# Order details, production history and notes
GET {{Web_HostAddress}}/api/orders/{{orderId}}

###

# All orders, newest first
GET {{Web_HostAddress}}/api/orders

###

# Confirm: starts production
POST {{Web_HostAddress}}/api/orders/{{orderId}}/confirm

###

# Cancel: only before confirmation, otherwise 422 with rule R8
POST {{Web_HostAddress}}/api/orders/{{orderId}}/cancel
Content-Type: application/json

{
  "reason": "Zmiana planów"
}

###

### ---------- Production: workshop ----------
# A job appears about half a second after an order is confirmed.

# @name productionQueue
GET {{Web_HostAddress}}/api/production/jobs

###

@jobId = {{productionQueue.response.body.$.items[0].id}}

# Only jobs at one stage: Printing, Assembly, QaTests, Packing or Shipped
GET {{Web_HostAddress}}/api/production/jobs?stage=Printing

###

# Complete the current stage (skipping one → 422 with rule R9)
POST {{Web_HostAddress}}/api/production/jobs/{{jobId}}/complete-stage
Content-Type: application/json

{
  "stage": "Printing",
  "completedBy": "Ania (warsztat)"
}

###

# Failed QA: back to Assembly; the second failure puts the job on hold (R10)
POST {{Web_HostAddress}}/api/production/jobs/{{jobId}}/fail-qa
Content-Type: application/json

{
  "reason": "Luźne mocowanie napędu"
}

###

# Continue a held job from Assembly
POST {{Web_HostAddress}}/api/production/jobs/{{jobId}}/release-hold

###

# Ship after packing
POST {{Web_HostAddress}}/api/production/jobs/{{jobId}}/ship
Content-Type: application/json

{
  "trackingNumber": "RF-2026-0001"
}

###

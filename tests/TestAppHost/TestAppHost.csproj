<Project Sdk="Aspire.AppHost.Sdk/13.6.1">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- DCP and the dashboard come from NuGet packages, so `dotnet run` works without the Aspire CLI. -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
    <RootNamespace>RoboForge.TestAppHost</RootNamespace>
    <AssemblyName>RoboForge.TestAppHost</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Shared\Shared.Hosting\Shared.Hosting.csproj" IsAspireProjectResource="false" />
  </ItemGroup>

</Project>
